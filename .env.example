# MCR Partners — environment template.
#
# Committed on purpose: keys only, never values. Copy to `.env` and fill in.
# Every variable the application reads is listed here; if you add a new
# `process.env` reference, add it here in the same commit.
#
# Anything without the NEXT_PUBLIC_ prefix is server-only and must never be
# imported into a client component.

# ============================================================
# Supabase
# ============================================================

# https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / publishable key — safe in the browser, respects RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# service_role key — SERVER ONLY, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# App
# ============================================================

# Public origin, no trailing slash. Used for Supabase auth redirects.
NEXT_PUBLIC_APP_URL=

# Optional. Identifies this app in the OpenRouter dashboard for observability;
# falls back to a placeholder when unset.
PUBLIC_APP_URL=

# Optional. "true" shows the financials comparison page's diagnostics — the
# "Statements on file" table and the statement checks (warnings and notes).
# Set it on development and preview deployments only. Unset (or anything but
# "true") is treated as production: they are hidden.
SHOW_FINANCIALS_DIAGNOSTICS=

# ============================================================
# AI — OpenRouter. Server only.
# ============================================================

# Must only ever be read by src/lib/ai/openrouterClient.ts.
OPENROUTER_API_KEY=

# ============================================================
# Email — Resend
# ============================================================

RESEND_API_KEY=

# Verified sender, e.g. "MCR Partners <noreply@mcrpartners.com.au>"
RESEND_FROM_EMAIL=

# ============================================================
# Lead ingestion — /api/webhooks/leads/[source]
# ============================================================

# Shared secret for the website and Google Form POSTs, sent as the
# X-MCR-Secret header. Generate with:  openssl rand -hex 32
# The same value goes in the PHP handler's server environment — never inline it
# in the snippet, where it would end up in a backup or a support ticket.
MCR_LEAD_SECRET=

# Echoed back during Meta's GET verification handshake. Any opaque string; it
# must match exactly what you enter in the Meta webhook configuration, or the
# subscription silently never activates.
META_VERIFY_TOKEN=

# App secret from the Meta app dashboard. Verifies the X-Hub-Signature-256 HMAC
# on inbound Facebook POSTs, computed over the raw request body.
META_APP_SECRET=

# Long-lived Page access token, used to fetch a lead's field values from the
# Graph API (the webhook delivers a leadgen_id, not the answers).
# Single-Page setups only need this one.
META_PAGE_ACCESS_TOKEN=

# Optional. JSON map of pageId -> token, so more than one Page can be live at
# once — e.g. the test Page and the real one during changeover. Takes precedence
# over META_PAGE_ACCESS_TOKEN when the incoming page_id is present as a key.
#   {"102938475610293":"EAAG...","504030201009080":"EAAH..."}
META_PAGE_TOKENS=

# Token used to resolve a lead's ad_id to its campaign, ad name and account at
# ingest (GET /{ad_id}?fields=account_id,name,campaign{id,name}).
#
# This is NOT a Page token — a Page token cannot read an ad. It needs a user or
# system-user token holding ads_read on the ad account that runs the campaigns.
#
# Optional: leave it unset and leads still store their raw page/form/ad/adgroup
# ids, just without campaign names. The webhook logs once per lead when it is
# missing, so the gap is never silent.
META_ADS_ACCESS_TOKEN=

# ============================================================
# Company lookup — Australian Business Register. Server only.
# ============================================================

# GUID from the ABR web services registration at
# https://abr.business.gov.au/Tools/WebServices — free, but it identifies MCR
# and the register rate limits against it, so it must never reach the browser.
# Only src/lib/abr/service.ts reads it; the two routes under /api/abr exist so
# the browser never has to.
#
# OPTIONAL. Leave it unset and the lookup control is hidden entirely — the
# conversion form works exactly as it did before lookup existed, typed by hand.
ABR_GUID=

# =============================================================
# Database tests — `npm run test:db` only. DEV project only.
# =============================================================

# Read by vitest.db.config.ts and nothing else. Deliberately separate from the
# app's Supabase variables above so the tests can never reach a project by
# accident: they insert (and then delete) synthetic rows. Never production.
# Leave unset and the database tests are skipped.
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=
SUPABASE_TEST_ANON_KEY=
