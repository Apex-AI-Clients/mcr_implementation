/*.pdf
graphify-out

# Verified figures of real test clients, and snapshots of their stored
# statements, for `npm run figures:check`. Real client data: never committed.
/verified-figures/

# Exported reports of real clients, dropped in for review. Never committed.
/pdfs/
/pdfs2/

# Gabby's historical SBR workbook (real client names and figures), used only
# for local dry runs of the Prediction Data import. Never committed.
/GABI AI DATA*.xlsx

# Database dumps dropped in the repo root. Never committed.
/*.sql

# Real clients' ATO activity statement exports, dropped in for local checks. Never committed.
/Activity statement*.csv
/Activity Statement*.csv

# Real director penalty notices, dropped in for `npm run figures:dpn`. They carry
# the director's home address. Never committed.
/dpn-samples/

# Supabase CLI state for the linked project (project ref, pooler host, org).
# Machine-local; never committed.
supabase/.temp/
